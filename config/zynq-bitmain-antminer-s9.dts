/* AtlANTian base hardware contract for Bitmain CTRL_C41 / Antminer S9. */
/dts-v1/;
#include "zynq-7000.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Bitmain Antminer S9 CTRL_C41";
	compatible = "bitmain,antminer-s9", "xlnx,zynq-7000";

	aliases {
		ethernet0 = &gem0;
		serial0 = &uart1;
		mmc0 = &sdhci0;
		gpio0 = &gpio0;
		nand0 = &nfc0;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x20000000>; /* measured 512 MiB */
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		bootcount@efffff0 { reg = <0x0efffff0 0x10>; no-map; };
		fpga_space@f000000 { reg = <0x0f000000 0x01000000>; no-map; };
	};

	chosen { stdout-path = "serial0:115200n8"; };

	/*
	 * D3 is the bicolour board-status LED.  Its two 2N7002 low-side
	 * switches are driven directly by PS MIO37 (red) and MIO38 (green).
	 * Board validation shows the illuminated state at a raw GPIO low, so the
	 * LED class must invert the physical level.  Export them through the
	 * standard LED class rather than leaving them as undocumented GPIOs.
	 */
	leds {
		compatible = "gpio-leds";

		status_red {
			label = "atlantian:red:status";
			gpios = <&gpio0 37 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		activity_green {
			label = "atlantian:green:activity";
			gpios = <&gpio0 38 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
	};

	/* The base image supplies FPGA infrastructure, never a bitstream. */
	fpga_full: fpga-full {
		compatible = "fpga-region";
		fpga-mgr = <&devcfg>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
	};

	/* Preserve native IIO and also expose XADC through standard hwmon/sensors. */
	xadc_hwmon: xadc-hwmon {
		compatible = "iio-hwmon";
		io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>,
			      <&adc 4>, <&adc 5>, <&adc 6>, <&adc 7>, <&adc 8>;
	};
};

&clkc { ps-clk-frequency = <33333333>; };

&gem0 {
	status = "okay";
	phy-mode = "rgmii-id";
	phy-handle = <&ethernet_phy>;
	ethernet_phy: ethernet-phy@1 { reg = <1>; };
};

&sdhci0 { status = "okay"; disable-wp; };
&uart1 { status = "okay"; };
&gpio0 { status = "okay"; };
&devcfg { status = "okay"; };
&adc {
	status = "okay";
	#io-channel-cells = <1>;
};
&smcc { status = "okay"; };
&nfc0 {
	status = "okay";

	/* The PL353 driver discovers chips from child chip-select nodes. */
	nand@0 {
		reg = <0>;
	};
};
&watchdog0 { reset-on-timeout; timeout-sec = <200>; };
