# Reproducible Debian rootfs input.  A published AtlANTian source revision
# always uses this exact Debian archive snapshot; advancing it is an explicit
# base-update change made by the Debian watcher.
DEBIAN_SNAPSHOT_TIMESTAMP=20250815T000000Z
DEBIAN_SNAPSHOT_MIRROR=https://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT_TIMESTAMP}
DEBIAN_SECURITY_SNAPSHOT_MIRROR=https://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT_TIMESTAMP}
