# Simple, conventional removable-media layout.  The image has only BOOT and
# root.  p2 is enlarged to the full card on its first boot; there is no hidden
# state partition and no reserved update area.
ATLANTIAN_BOOT_MIB=64
# This is temporary formatting/copying headroom, not reserved runtime space:
# p2 expands to the complete SD card on first boot.  It covers ext4 metadata,
# inode tables and package hard-link/copy overhead that `du` cannot predict.
ATLANTIAN_INITIAL_ROOT_SLACK_MIB=64
