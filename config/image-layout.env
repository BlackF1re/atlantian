# Immutable on-card layout.  p1 and p2 are replaced as one release bundle;
# p3 is the growable, persistent user-data partition.
ATLANTIAN_BOOT_MIB=64
# 336 MiB is the established on-card ABI: early AtlANTian cards already have
# this exact p2 size.  Do not grow it in a regular release; that would make an
# otherwise verified ext4 payload truncate on those cards.  A larger system
# partition requires an explicit factory/recovery migration.
ATLANTIAN_SYSTEM_MIB=336
ATLANTIAN_INITIAL_DATA_MIB=16
