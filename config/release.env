# AtlANTian release identity.  ATLANTIAN_BUILD advances only when the Debian
# base changes.  Every published build also carries the exact source commit,
# which makes a release reproducible without forcing a kernel rebuild.
DEBIAN_CODENAME=trixie
DEBIAN_MAJOR=13
ATLANTIAN_BUILD=1
ATLANTIAN_SOURCE_REVISION=${ATLANTIAN_SOURCE_REVISION:-$(git rev-parse --short=12 HEAD 2>/dev/null || printf 'local')}
ATLANTIAN_VERSION=${ATLANTIAN_VERSION:-"${DEBIAN_MAJOR}.${ATLANTIAN_BUILD}+g${ATLANTIAN_SOURCE_REVISION}"}
ATLANTIAN_RELEASE_ID=${ATLANTIAN_RELEASE_ID:-"atlantian-${DEBIAN_MAJOR}-${ATLANTIAN_BUILD}+g${ATLANTIAN_SOURCE_REVISION}"}
ATLANTIAN_IMAGE_NAME=${ATLANTIAN_IMAGE_NAME:-$ATLANTIAN_RELEASE_ID}
ATLANTIAN_KERNEL_VERSION=6.12.100
# Immutable kernel source input for published releases.  The annotated stable
# tag is resolved once here rather than trusting a movable remote ref in CI.
ATLANTIAN_KERNEL_COMMIT=52a355b23cd2dd77b683ed1a1bbe2b7408bd9c74
# CONFIG_LOCALVERSION_AUTO is disabled by build-kernel.sh: no git hash and no
# accidental "-dirty" suffix may enter a published kernel release string.
ATLANTIAN_KERNEL_LOCALVERSION="-atlantian.${DEBIAN_MAJOR}.${ATLANTIAN_BUILD}"
