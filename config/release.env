# AtlANTian release identity.  This is the only place a maintainer advances
# the AtlANTian build number after a published image.
DEBIAN_CODENAME=trixie
DEBIAN_MAJOR=13
ATLANTIAN_BUILD=2
ATLANTIAN_RELEASE_ID="atlantian-${DEBIAN_MAJOR}-${ATLANTIAN_BUILD}"
ATLANTIAN_IMAGE_NAME="$ATLANTIAN_RELEASE_ID"
ATLANTIAN_KERNEL_VERSION=6.12.100
# CONFIG_LOCALVERSION_AUTO is disabled by build-kernel.sh: no git hash and no
# accidental "-dirty" suffix may enter a published kernel release string.
ATLANTIAN_KERNEL_LOCALVERSION="-atlantian.${DEBIAN_MAJOR}.${ATLANTIAN_BUILD}"
