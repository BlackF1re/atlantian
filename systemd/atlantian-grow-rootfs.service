[Unit]
Description=Expand AtlANTian SD root filesystem to card capacity
DefaultDependencies=no
After=local-fs.target
Before=multi-user.target
ConditionPathExists=!/var/lib/atlantian/mmc-filesystem-expanded

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/atlantian-grow-rootfs

[Install]
WantedBy=multi-user.target
